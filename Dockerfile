# Minimal Dockerfile for OpenCode Server
# GitHub Actions builds this on every push to main branch
# Bypasses npm v10 catalog: protocol issues by avoiding npm install in Docker build

FROM node:18-alpine

WORKDIR /app

# Copy package files (only for reference, not installing deps via Docker COPY context)
COPY package.json ./

# Copy the built OpenCode distribution from the source checkout
# GitHub Actions actions/checkout provides the source code repository
# The dist/ directory is generated by npm run build, but we copy it if available
COPY dist ./dist 2>/dev/null || true

# Copy .home directory configuration
COPY .home .home 2>/dev/null || true

# Copy .npmrc for registry configuration (if it exists in the repo)
COPY .npmrc .npmrc 2>/dev/null || true

# Expose OpenCode port
EXPOSE 4096

# Start OpenCode server using the distributed entry point
# The server initializes with its built-in configuration
ENTRYPOINT ["node", "dist/index.js"]